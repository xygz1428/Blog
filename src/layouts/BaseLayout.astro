---
import { SITE } from '../site.mjs';
import { withBase, stripBase } from '../utils/url';
import { t, localizedHref } from '../i18n/utils';
import { LOCALES, LOCALE_LABELS, HTML_LANG, DEFAULT_LOCALE, type Locale } from '../i18n/ui';
import '../styles/global.css';
// KaTeX 的排版样式（字体、间距、上下标）。不引入这行，公式会退化成无样式的字符。
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传 true，标题就只显示文章名 */
  isPost?: boolean;
  locale?: Locale;
  /** 各语言下对应的路径，用于语言切换（缺省则回该语言首页） */
  altPaths?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  isPost = false,
  locale = DEFAULT_LOCALE,
  altPaths = {},
} = Astro.props;

const dict = t(locale);
// 页面没传描述时，用当前语言的站点描述，避免英文页出现中文摘要
const pageDescription = description ?? dict.siteDescription;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${dict.siteTagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
const currentPath = stripBase(Astro.url.pathname);
const ogImage = new URL(withBase('/og.png'), SITE.url).toString();

// 导航项：语言无关的路径 + 当前语言的文案
const navItems = [
  { href: '/', label: dict.navHome },
  { href: '/blog', label: dict.navBlog },
  { href: '/archive', label: dict.navArchive },
  { href: '/tags', label: dict.navTags },
  { href: '/search', label: dict.navSearch },
  { href: '/gallery', label: dict.navGallery },
  { href: '/about', label: dict.navAbout },
];

// 所有页面均已三语化，导航项在各语言下都显示
const visibleNav = navItems;

const isActive = (href: string) => {
  const stripped = currentPath.replace(/\/$/, '') || '/';
  const target = href === '/' ? '/' : href;
  return stripped === target || (target !== '/' && stripped.startsWith(target));
};
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={withBase('/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- 安全策略：GitHub Pages 不支持自定义响应头，只能用 meta 形式 -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={isPost ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    {
      /* 多语言页面互相声明 hreflang，只列真实存在的版本 */
      Object.entries(altPaths).map(([loc, path]) => (
        <link rel="alternate" hreflang={HTML_LANG[loc as Locale]} href={new URL(localizedHref(loc as Locale, path), Astro.site ?? 'https://example.com')} />
      ))
    }

    <!-- 主题：在首次绘制前定好，避免闪白 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('blog-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body>
    {isPost && <div class="reading-progress-bar" aria-hidden="true"><span id="progress-fill"></span></div>}
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase(localizedHref(locale, '/'))}>{SITE.title}</a>
        <nav class="nav">
          {
            visibleNav.map((item) => (
              <a href={withBase(localizedHref(locale, item.href))} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <span class="lang-switch" aria-label={dict.langToggle}>
            {
              LOCALES.map((loc) => (
                <a
                  href={withBase(localizedHref(loc, altPaths[loc] ?? '/'))}
                  class:list={['lang-link', { 'is-current': loc === locale }]}
                  hreflang={HTML_LANG[loc]}
                  aria-current={loc === locale ? 'true' : undefined}
                >
                  {LOCALE_LABELS[loc]}
                </a>
              ))
            }
          </span>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label={dict.themeToggle}>
            <span id="theme-icon">◐</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.title} · {SITE.author}</span>
        <span>
          <a href={withBase('/rss.xml')}>RSS</a>
          <span> · </span>
          <a href="https://astro.build" rel="noopener" target="_blank">Astro</a>
        </span>
      </div>
    </footer>

    {isPost && <button class="scroll-to-top" id="scroll-top" type="button" aria-label={dict.backToTop}>↑</button>}

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        var icon = document.getElementById('theme-icon');
        function paint(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          if (icon) icon.textContent = theme === 'dark' ? '☀' : '◐';
        }
        paint(document.documentElement.getAttribute('data-theme') || 'light');
        if (btn) {
          btn.addEventListener('click', function () {
            var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            paint(next);
            try { localStorage.setItem('blog-theme', next); } catch (e) {}
          });
        }
      })();
    </script>

    <script>
      // ── 阅读进度条 + 回到顶部 ────────────────────────────────
      const fill = document.getElementById('progress-fill');
      const topBtn = document.getElementById('scroll-top');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function onScroll() {
        if (fill) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
          fill.style.width = (ratio * 100).toFixed(2) + '%';
        }
        if (topBtn) topBtn.classList.toggle('is-visible', window.scrollY > 600);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      topBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      });

      // ── 代码块复制按钮 ──────────────────────────────────────
      for (const pre of Array.from(document.querySelectorAll<HTMLPreElement>('pre.astro-code'))) {
        if (pre.querySelector('.copy-btn')) continue;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-btn';
        button.textContent = '复制';
        button.setAttribute('aria-label', '复制代码');

        button.addEventListener('click', async () => {
          const codeEl = pre.querySelector('code');
          const code = codeEl?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(code);
            button.textContent = '已复制';
          } catch {
            if (codeEl) {
              const range = document.createRange();
              range.selectNodeContents(codeEl);
              const selection = window.getSelection();
              selection?.removeAllRanges();
              selection?.addRange(range);
            }
            button.textContent = '请手动复制';
          }
          window.setTimeout(() => {
            button.textContent = '复制';
          }, 1500);
        });

        pre.appendChild(button);
      }

      // ── 图注：图片下一行的纯斜体段落 → figcaption ──────────
      for (const img of Array.from(document.querySelectorAll<HTMLImageElement>('.post-body img'))) {
        const holder = img.parentElement;
        if (!holder || holder.tagName !== 'P') continue;
        const next = holder.nextElementSibling;
        const isCaption =
          next !== null &&
          next.tagName === 'P' &&
          next.children.length === 1 &&
          next.firstElementChild?.tagName === 'EM';
        if (!isCaption) continue;

        const figure = document.createElement('figure');
        holder.parentNode?.insertBefore(figure, holder);
        figure.appendChild(img);
        const caption = document.createElement('figcaption');
        caption.textContent = next.firstElementChild?.textContent ?? '';
        figure.appendChild(caption);
        next.remove();
        if ((holder.textContent ?? '').trim() === '') holder.remove();
      }

      // ── 图片灯箱 ──────────────────────────────────────────
      const lightbox = document.createElement('div');
      lightbox.className = 'lightbox';
      lightbox.setAttribute('role', 'dialog');
      lightbox.setAttribute('aria-label', '图片预览');
      const lightboxImg = document.createElement('img');
      lightbox.appendChild(lightboxImg);
      document.body.appendChild(lightbox);

      const closeLightbox = () => {
        lightbox.classList.remove('is-open');
        lightboxImg.removeAttribute('src');
      };

      for (const img of Array.from(document.querySelectorAll<HTMLImageElement>('.post-body img, .gallery-item img'))) {
        img.addEventListener('click', () => {
          lightboxImg.src = img.currentSrc || img.src;
          lightboxImg.alt = img.alt;
          lightbox.classList.add('is-open');
        });
      }

      lightbox.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeLightbox();
      });
    </script>
  </body>
</html>
