---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFoundView from '../components/NotFoundView.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { t } from '../i18n/utils';

const dict = t(DEFAULT_LOCALE);
---

<BaseLayout title={dict.notFoundTitle} description={dict.notFoundDesc} locale={DEFAULT_LOCALE}>
  <NotFoundView locale={DEFAULT_LOCALE} />
</BaseLayout>
