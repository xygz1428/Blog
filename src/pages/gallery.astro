---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryView from '../components/GalleryView.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { t } from '../i18n/utils';

const dict = t(DEFAULT_LOCALE);
---

<BaseLayout
  title={dict.navGallery}
  locale={DEFAULT_LOCALE}
  altPaths={{ 'zh-cn': '/gallery/', en: '/gallery/' }}
>
  <GalleryView locale={DEFAULT_LOCALE} />
</BaseLayout>
