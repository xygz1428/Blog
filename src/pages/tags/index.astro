---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/posts';
import { withBase } from '../../utils/url';

const tags = await getAllTags();
const total = tags.reduce((sum, item) => sum + item.count, 0);

// 按文章数分三档，用字号体现权重（借鉴数字花园式索引的可扫读性）
function tier(count: number): string {
  if (count >= 4) return 'tag-lg';
  if (count >= 2) return 'tag-md';
  return 'tag-sm';
}
---

<BaseLayout title="标签" description="按标签浏览全部文章">
  <div class="page-head">
    <h1>标签</h1>
    <p>共 {tags.length} 个标签 · {total} 次使用</p>
  </div>

  {
    tags.length === 0 ? (
      <p class="empty">还没有标签。在文章的 frontmatter 里写 tags 即可。</p>
    ) : (
      <div class="tag-cloud">
        {tags.map((item) => (
          <a class={`tag ${tier(item.count)}`} href={withBase(`/tags/${item.tag}/`)}>
            {item.tag}
            <span class="tag-count">{item.count}</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
