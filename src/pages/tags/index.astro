---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagsView from '../../components/TagsView.astro';
import { DEFAULT_LOCALE } from '../../i18n/ui';
import { t } from '../../i18n/utils';

const dict = t(DEFAULT_LOCALE);
---

<BaseLayout
  title={dict.tagsTitle}
  locale={DEFAULT_LOCALE}
  altPaths={{ 'zh-cn': '/tags/', en: '/tags/' }}
>
  <TagsView locale={DEFAULT_LOCALE} />
</BaseLayout>
