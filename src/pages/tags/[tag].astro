---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagView from '../../components/TagView.astro';
import { getAllPosts } from '../../utils/posts';
import { DEFAULT_LOCALE } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getAllPosts(DEFAULT_LOCALE);
  const tags = new Set<string>();
  for (const post of posts) for (const tag of post.data.tags) tags.add(tag);
  return [...tags].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
---

<BaseLayout title={tag} locale={DEFAULT_LOCALE}>
  <TagView locale={DEFAULT_LOCALE} tag={tag!} />
</BaseLayout>
