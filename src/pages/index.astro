---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.mjs';
import { getAllPosts, getCategoryCounts, formatDate, postSlug } from '../utils/posts';
import { getCover } from '../utils/covers';
import { withBase } from '../utils/url';

const posts = await getAllPosts();
const latest = posts.slice(0, SITE.pageSize);
const counts = await getCategoryCounts();
const heroCover = getCover('hero-quiet.jpg');
---

<BaseLayout>
  <section class="hero">
    <div class="hero-text">
      <h1>{SITE.title}</h1>
      <p>{SITE.tagline}。这里记录科研过程、编程实践、学习笔记，以及一些生活随笔。</p>
    </div>
    {
      heroCover && (
        <div class="hero-media">
          <Image src={heroCover} alt="白色展墙与几何浮雕" width={360} height={480} format="webp" loading="eager" />
        </div>
      )
    }
  </section>

  <h2>最新文章</h2>
  {
    latest.length === 0 ? (
      <p class="empty">还没有文章。在 <code>src/content/blog/</code> 下新建 Markdown 文件即可。</p>
    ) : (
      <ul class="post-list">
        {latest.map((post) => {
          const cover = getCover(post.data.cover);
          return (
            <li class="post-item">
              <div class="post-item-main">
                <h2>
                  <a href={withBase(`/blog/${postSlug(post)}/`)}>{post.data.title}</a>
                </h2>
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span>·</span>
                  <a href={withBase(`/categories/${post.data.category}/`)}>{post.data.category}</a>
                  {post.data.tags.length > 0 && <span>·</span>}
                  {post.data.tags.map((tag) => (
                    <a class="tag" href={withBase(`/tags/${tag}/`)}>{tag}</a>
                  ))}
                </div>
                {post.data.description && <p class="post-desc">{post.data.description}</p>}
              </div>
              {cover && (
                <a class="post-thumb" href={withBase(`/blog/${postSlug(post)}/`)} tabindex="-1" aria-hidden="true">
                  <Image src={cover} alt="" width={200} height={140} format="webp" loading="lazy" />
                </a>
              )}
            </li>
          );
        })}
      </ul>
    )
  }

  <p style="margin-top:1.5rem">
    <a href={withBase('/blog/')}>查看全部文章 →</a>
  </p>

  <h2>分类</h2>
  <ul class="cat-grid">
    {
      SITE.categories.map((category) => (
        <li>
          <a class="cat-card" href={withBase(`/categories/${category}/`)}>
            <strong>{category}</strong>
            <span>{counts[category] ?? 0} 篇</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
