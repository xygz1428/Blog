---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutView from '../../components/AboutView.astro';
import ParticleBackdrop from '../../components/ParticleBackdrop.astro';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '../../i18n/ui';
import { t } from '../../i18n/utils';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
---

<BaseLayout
  title={dict.navAbout}
  locale={locale}
  altPaths={{ 'zh-cn': '/about/', en: '/about/' }}
>
  <ParticleBackdrop variant="page" count={40} linkDistance={150} sizeMin={2} sizeMax={5} />
  <AboutView locale={locale} />
</BaseLayout>
