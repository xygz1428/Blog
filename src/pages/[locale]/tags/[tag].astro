---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TagView from '../../../components/TagView.astro';
import { getAllPosts } from '../../../utils/posts';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const routes = [];
  for (const locale of LOCALES.filter((l) => l !== DEFAULT_LOCALE)) {
    const posts = await getAllPosts(locale);
    const tags = new Set<string>();
    for (const post of posts) for (const tag of post.data.tags) tags.add(tag);
    for (const tag of tags) routes.push({ params: { locale, tag } });
  }
  return routes;
}

const locale = Astro.params.locale as Locale;
const tag = Astro.params.tag as string;
---

<BaseLayout title={tag} locale={locale}>
  <TagView locale={locale} tag={tag} />
</BaseLayout>
