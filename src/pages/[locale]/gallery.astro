---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryView from '../../components/GalleryView.astro';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '../../i18n/ui';
import { t } from '../../i18n/utils';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
---

<BaseLayout title={dict.navGallery} locale={locale} altPaths={{ 'zh-cn': '/gallery/', en: '/gallery/' }}>
  <GalleryView locale={locale} />
</BaseLayout>
