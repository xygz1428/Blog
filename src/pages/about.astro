---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutView from '../components/AboutView.astro';
import ParticleBackdrop from '../components/ParticleBackdrop.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
---

<BaseLayout title="关于" locale={DEFAULT_LOCALE} altPaths={{ 'zh-cn': '/about/', en: '/about/' }}>
  <ParticleBackdrop variant="page" count={48} linkDistance={150} sizeMin={4} sizeMax={10} />
  <AboutView locale={DEFAULT_LOCALE} />
</BaseLayout>
