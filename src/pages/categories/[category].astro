---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryView from '../../components/CategoryView.astro';
import { SITE } from '../../site.mjs';
import { DEFAULT_LOCALE } from '../../i18n/ui';

export async function getStaticPaths() {
  return SITE.categories.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
---

<BaseLayout title={category} locale={DEFAULT_LOCALE}>
  <CategoryView locale={DEFAULT_LOCALE} category={category!} />
</BaseLayout>
