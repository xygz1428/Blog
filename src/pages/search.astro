---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchView from '../components/SearchView.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { t } from '../i18n/utils';

const dict = t(DEFAULT_LOCALE);
---

<BaseLayout
  title={dict.navSearch}
  locale={DEFAULT_LOCALE}
  altPaths={{ 'zh-cn': '/search/', en: '/search/' }}
>
  <SearchView locale={DEFAULT_LOCALE} />
</BaseLayout>
