---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveView from '../components/ArchiveView.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { t } from '../i18n/utils';

const dict = t(DEFAULT_LOCALE);
---

<BaseLayout
  title={dict.archiveTitle}
  locale={DEFAULT_LOCALE}
  altPaths={{ 'zh-cn': '/archive/', en: '/archive/' }}
>
  <ArchiveView locale={DEFAULT_LOCALE} />
</BaseLayout>
