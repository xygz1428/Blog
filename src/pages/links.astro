---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinksView from '../components/LinksView.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';
import { t } from '../i18n/utils';

const dict = t(DEFAULT_LOCALE);
---

<BaseLayout
  title={dict.navLinks}
  locale={DEFAULT_LOCALE}
  altPaths={{ 'zh-cn': '/links/', en: '/links/' }}
>
  <LinksView locale={DEFAULT_LOCALE} />
</BaseLayout>
