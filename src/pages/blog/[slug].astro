---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getNeighbors, formatDate, readingTime } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const { prev, next } = getNeighbors(posts, post.id);

// 目录只取 h2 / h3，少于两条就不显示
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutes = readingTime(post.body);
---

<BaseLayout title={post.data.title} description={post.data.description || post.data.title} isPost>
  <div class="post-layout">
    <article>
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.updatedDate && <span>（更新于 {formatDate(post.data.updatedDate)}）</span>}
          <span>·</span>
          <a href={withBase(`/categories/${post.data.category}/`)}>{post.data.category}</a>
          <span>·</span>
          <span>{minutes} 分钟阅读</span>
          {post.data.tags.length > 0 && <span>·</span>}
          {post.data.tags.map((tag) => (
            <a class="tag" href={withBase(`/tags/${tag}/`)}>{tag}</a>
          ))}
        </div>
      </header>

      <div class="post-body">
        <Content />
      </div>

      <nav class="post-nav">
        <span>{prev ? <a href={withBase(`/blog/${prev.id}/`)}>← {prev.data.title}</a> : null}</span>
        <span>{next ? <a href={withBase(`/blog/${next.id}/`)}>{next.data.title} →</a> : null}</span>
      </nav>
    </article>

    {
      toc.length > 1 && (
        <aside class="post-toc" aria-label="文章目录">
          <div class="toc-title">目录</div>
          <ul>
            {toc.map((heading) => (
              <li class:list={['toc-item', `toc-h${heading.depth}`]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  // 目录随滚动高亮当前章节
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.post-toc a'));
  if (links.length > 0) {
    const targets = links
      .map((link) => {
        const id = decodeURIComponent(link.getAttribute('href')?.slice(1) ?? '');
        const el = document.getElementById(id);
        return el ? { link, el } : null;
      })
      .filter((entry): entry is { link: HTMLAnchorElement; el: HTMLElement } => entry !== null);

    const setActive = (activeLink: HTMLAnchorElement | null) => {
      for (const link of links) link.classList.toggle('is-active', link === activeLink);
    };

    const onScroll = () => {
      // 取最后一个已经滚过视口上沿 20% 处的标题
      let current: HTMLAnchorElement | null = null;
      for (const { link, el } of targets) {
        if (el.getBoundingClientRect().top <= window.innerHeight * 0.2) current = link;
      }
      setActive(current);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
