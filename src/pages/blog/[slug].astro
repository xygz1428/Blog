---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostView from '../../components/PostView.astro';
import { getAllPosts, getTranslations, postSlug } from '../../utils/posts';
import { DEFAULT_LOCALE } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getAllPosts(DEFAULT_LOCALE);
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const slug = postSlug(post);

// 语言切换：只指向真实存在的翻译，没有就回该语言首页
const translations = await getTranslations(slug);
const altPaths: Record<string, string> = { 'zh-cn': `/blog/${slug}/` };
for (const tr of translations) altPaths[tr.locale] = `/blog/${tr.slug}/`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description || post.data.title}
  isPost
  locale={DEFAULT_LOCALE}
  altPaths={altPaths}
>
  <PostView post={post} posts={posts} locale={DEFAULT_LOCALE} />
</BaseLayout>
