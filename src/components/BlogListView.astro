---
import { Image } from 'astro:assets';
import { getAllPosts, formatDate, postSlug } from '../utils/posts';
import { getCover } from '../utils/covers';
import { withBase } from '../utils/url';
import { t, localizedHref, categoryLabel } from '../i18n/utils';
import { DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const isDefault = locale === DEFAULT_LOCALE;
const posts = await getAllPosts(locale);
---

<div class="page-head">
  <h1>{dict.navBlog}</h1>
  <p>{dict.postCount(posts.length)}</p>
</div>

{
  posts.length === 0 ? (
    <p class="empty">{dict.noPosts}</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => {
        const cover = getCover(post.data.cover);
        const href = withBase(localizedHref(locale, `/blog/${postSlug(post)}/`));
        return (
          <li class="post-item">
            <div class="post-item-main">
              <h2>
                <a href={href}>{post.data.title}</a>
              </h2>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span>·</span>
                {isDefault ? (
                  <a href={withBase(`/categories/${post.data.category}/`)}>{categoryLabel(locale, post.data.category)}</a>
                ) : (
                  <span>{categoryLabel(locale, post.data.category)}</span>
                )}
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              {post.data.description && <p class="post-desc">{post.data.description}</p>}
            </div>
            {cover && (
              <a class="post-thumb" href={href} tabindex="-1" aria-hidden="true">
                <Image src={cover} alt="" width={200} height={140} format="webp" loading="lazy" />
              </a>
            )}
          </li>
        );
      })}
    </ul>
  )
}
