---
import { SITE } from '../site.mjs';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// 需要你替换的占位内容，用【】标出；改完这段就能变成你自己的介绍
const copy = {
  'zh-cn': {
    greeting: '你好，我是【你的名字】',
    doing: '我在做【一句话说清你现在在做什么，比如：某某方向的科研 / 某某方向的前端开发】。',
    before: '在此之前，【可选：上一段经历或学校，没有就删掉这一行】。',
    intro:
      '这个博客记录科研过程、编程实践、学习笔记，以及一些生活随笔。建站的出发点很简单：把散落在笔记软件、聊天记录和脑子里的东西，整理成能长期检索的形式。',
    believeTitle: '我信这些',
    believes: [
      '写下来才算想清楚',
      '具体比宏大有用',
      '方法可以学，品味也可以学',
      '慢一点，但别停',
    ],
    writeTitle: '我常写',
    writes: [
      ['科研', '论文阅读、实验设计、数据处理与复现中的坑'],
      ['技术', '工具链、工程实践、踩坑记录'],
      ['学习', '笔记法、复盘、知识整理'],
      ['生活', '随笔与杂记'],
    ],
    contactTitle: '找我',
    contact: '在 GitHub 上找我，或者用 RSS 订阅。留言写在文章底部。',
  },
  en: {
    greeting: "Hi, I'm 【your name】",
    doing: 'Right now I am 【one line about what you do, e.g. research in X / frontend work on Y】.',
    before: 'Before this, 【optional: previous role or school — delete this line if not needed】.',
    intro:
      'This blog holds research notes, engineering practice, study logs and the occasional essay. The motivation is simple: turn things scattered across note apps, chat logs and my head into something searchable years later.',
    believeTitle: 'Things I believe',
    believes: [
      'Writing it down is how you find out whether you understand it',
      'Concrete beats grand',
      'Method is learnable, so is taste',
      'Slower, but do not stop',
    ],
    writeTitle: 'What I write about',
    writes: [
      ['Research', 'Paper reading, experiment design, data processing, reproduction pitfalls'],
      ['Engineering', 'Toolchains, practice, lessons from bugs'],
      ['Learning', 'Note-taking, review, knowledge organisation'],
      ['Life', 'Essays and fragments'],
    ],
    contactTitle: 'Say hi',
    contact: 'Find me on GitHub, or subscribe via RSS. Comments live at the bottom of each post.',
  },
} as const;

const c = copy[locale];
---

<div class="about-page">
  <h1 class="about-greeting">{c.greeting}</h1>
  <p>{c.doing}</p>
  <p>{c.before}</p>
  <p>{c.intro}</p>

  <h2>{c.believeTitle}</h2>
  <ul class="about-plain">
    {c.believes.map((item) => <li>{item}</li>)}
  </ul>

  <h2>{c.writeTitle}</h2>
  <ul class="about-plain">
    {c.writes.map(([name, desc]) => (
      <li><strong>{name}</strong>：{desc}</li>
    ))}
  </ul>

  <h2>{c.contactTitle}</h2>
  <p>{c.contact}</p>
</div>
