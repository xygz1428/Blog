---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

// 图集图片：全部 CC0，来源见 docs/图片来源台账.md
const modules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpg,jpeg,png,webp}', {
  eager: true,
});

const files = Object.entries(modules)
  .map(([path, mod]) => ({
    name: path.split('/').pop() ?? '',
    src: mod.default,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const landscapes = files.filter((f) => f.name.startsWith('land-'));
const artworks = files.filter((f) => f.name.startsWith('art-'));
---

<div class="page-head">
  <h1>{dict.navGallery}</h1>
  <p>{dict.postCount(files.length)} · CC0</p>
</div>

<h2>风景</h2>
<div class="gallery-grid">
  {
    landscapes.map((item) => (
      <figure class="gallery-item">
        <Image
          src={item.src}
          alt=""
          widths={[320, 640]}
          sizes="(max-width: 640px) 50vw, 320px"
          format="webp"
          loading="lazy"
        />
      </figure>
    ))
  }
</div>

<h2>插画</h2>
<div class="gallery-grid">
  {
    artworks.map((item) => (
      <figure class="gallery-item">
        <Image
          src={item.src}
          alt=""
          widths={[320, 640]}
          sizes="(max-width: 640px) 50vw, 320px"
          format="webp"
          loading="lazy"
        />
      </figure>
    ))
  }
</div>

<p class="gallery-note">
  所有图片均为 CC0 授权，可自由使用。来源记录在仓库的 <code>docs/图片来源台账.md</code>。
</p>
