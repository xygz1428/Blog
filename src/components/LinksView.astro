---
import { friends, references, imageSources, wallpaperSources, type LinkItem } from '../data/links';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const heading = {
  'zh-cn': { title: '友链', friends: '友链', refs: '参考站点', images: '图片来源', wallpaper: '壁纸资源（仅链接）', apply: '想交换友链？在 GitHub 上找我。' },
  en: { title: 'Links', friends: 'Friends', refs: 'References', images: 'Image sources', wallpaper: 'Wallpaper sites (links only)', apply: 'Want to exchange links? Find me on GitHub.' },
} as const;

const c = heading[locale];

function badgeOf(item: LinkItem): string {
  return item.badge ?? item.name.trim().charAt(0).toUpperCase();
}
---

<div class="page-head">
  <h1>{c.title}</h1>
  <p>{c.apply}</p>
</div>

<h2>{c.friends}</h2>
<div class="link-grid">
  {
    friends.map((item) => (
      <a class="link-card" href={item.url} target="_blank" rel="noopener noreferrer">
        <span class="link-badge" aria-hidden="true">{badgeOf(item)}</span>
        <span class="link-body">
          <strong>{item.name}</strong>
          <span class="link-desc">{item.desc}</span>
        </span>
      </a>
    ))
  }
</div>

<h2>{c.refs}</h2>
<div class="link-grid">
  {
    references.map((item) => (
      <a class="link-card" href={item.url} target="_blank" rel="noopener noreferrer">
        <span class="link-badge" aria-hidden="true">{badgeOf(item)}</span>
        <span class="link-body">
          <strong>{item.name}</strong>
          <span class="link-desc">{item.desc}</span>
        </span>
      </a>
    ))
  }
</div>

<h2>{c.wallpaper}</h2>
<div class="link-grid">
  {
    wallpaperSources.map((item) => (
      <a class="link-card" href={item.url} target="_blank" rel="noopener noreferrer">
        <span class="link-badge" aria-hidden="true">{badgeOf(item)}</span>
        <span class="link-body">
          <strong>{item.name}</strong>
          <span class="link-desc">{item.desc}</span>
        </span>
      </a>
    ))
  }
</div>

<h2>{c.images}</h2>
<div class="link-grid">
  {
    imageSources.map((item) => (
      <a class="link-card" href={item.url} target="_blank" rel="noopener noreferrer">
        <span class="link-badge" aria-hidden="true">{badgeOf(item)}</span>
        <span class="link-body">
          <strong>{item.name}</strong>
          <span class="link-desc">{item.desc}</span>
        </span>
      </a>
    ))
  }
</div>
