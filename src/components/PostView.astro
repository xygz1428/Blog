---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { getNeighbors, formatDate, readingTime, postSlug, type Post } from '../utils/posts';
import { getCover } from '../utils/covers';
import { withBase } from '../utils/url';
import { t, localizedHref, categoryLabel } from '../i18n/utils';
import Comments from './Comments.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props {
  post: Post;
  posts: Post[];
  locale: Locale;
}

const { post, posts, locale } = Astro.props;
const dict = t(locale);
const isDefault = locale === DEFAULT_LOCALE;

const { Content, headings } = await render(post);
const { prev, next } = getNeighbors(posts, postSlug(post));
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = readingTime(post.body);
const cover = getCover(post.data.cover);
---

<div class="post-layout">
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>（{dict.updatedAt} {formatDate(post.data.updatedDate)}）</span>}
        <span>·</span>
        {isDefault ? (
          <a href={withBase(`/categories/${post.data.category}/`)}>{categoryLabel(locale, post.data.category)}</a>
        ) : (
          <span>{categoryLabel(locale, post.data.category)}</span>
        )}
        <span>·</span>
        <span>{dict.readingTime(minutes)}</span>
        {post.data.tags.length > 0 && <span>·</span>}
        {post.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>

    {
      cover && (
        <div class="post-cover">
          <Image src={cover} alt={post.data.title} width={880} format="webp" loading="eager" />
        </div>
      )
    }

    <div class="post-body">
      <Content />
    </div>

    <Comments locale={locale} />

    <nav class="post-nav">
      <span>
        {prev ? <a href={withBase(localizedHref(locale, `/blog/${postSlug(prev)}/`))}>← {prev.data.title}</a> : null}
      </span>
      <span>
        {next ? <a href={withBase(localizedHref(locale, `/blog/${postSlug(next)}/`))}>{next.data.title} →</a> : null}
      </span>
    </nav>
  </article>

  {
    toc.length > 1 && (
      <aside class="post-toc" aria-label={dict.toc}>
        <div class="toc-title">{dict.toc}</div>
        <ul>
          {toc.map((heading) => (
            <li class:list={['toc-item', `toc-h${heading.depth}`]}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</div>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.post-toc a'));
  if (links.length > 0) {
    const targets = links
      .map((link) => {
        const id = decodeURIComponent(link.getAttribute('href')?.slice(1) ?? '');
        const el = document.getElementById(id);
        return el ? { link, el } : null;
      })
      .filter((entry): entry is { link: HTMLAnchorElement; el: HTMLElement } => entry !== null);

    const setActive = (activeLink: HTMLAnchorElement | null) => {
      for (const link of links) link.classList.toggle('is-active', link === activeLink);
    };

    const onScroll = () => {
      let current: HTMLAnchorElement | null = null;
      for (const { link, el } of targets) {
        if (el.getBoundingClientRect().top <= window.innerHeight * 0.2) current = link;
      }
      setActive(current);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
