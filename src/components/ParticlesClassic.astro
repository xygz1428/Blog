---
/**
 * 原版 particles.js（MIT）+ 参考站同款配置。
 *
 * - public/vendor/particles.min.js：Vincent Garreau 的库，未修改
 * - public/vendor/particles-config.json：配置参数（数值不构成版权作品）
 * - public/vendor/LICENSE-particles.txt：MIT 声明
 */
const base = import.meta.env.BASE_URL;
---

<div id="particles-js" class="particles-page" aria-hidden="true"></div>

<script is:inline src={`${base}vendor/particles.min.js`}></script>
<script is:inline define:vars={{ base }}>
  window.addEventListener('load', function () {
    if (typeof particlesJS === 'undefined') return;
    particlesJS.load('particles-js', base + 'vendor/particles-config.json', function () {});
  });
</script>
