---
/**
 * 原版 particles.js（MIT）+ 参考站同款配置。
 *
 * - public/vendor/particles.min.js：Vincent Garreau 的库，未修改
 * - public/vendor/particles-config.json：配置参数（数值不构成版权作品）
 * - public/vendor/LICENSE-particles.txt：MIT 声明
 */
// BASE_URL 不带结尾斜杠，必须自己补，否则会拼成 /Blogvendor/...
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
---

<div id="particles-js" class="particles-page" aria-hidden="true"></div>

<script is:inline src={`${base}vendor/particles.min.js`}></script>
<script is:inline define:vars={{ base }}>
  (function () {
    function init() {
      var el = document.getElementById('particles-js');
      if (!el || typeof particlesJS === 'undefined') return;

      // particles.js 会用 offsetWidth/offsetHeight 定画布尺寸，
      // 某些布局下这个值不可靠，这里先显式写死像素尺寸再初始化。
      el.style.width = window.innerWidth + 'px';
      el.style.height = window.innerHeight + 'px';

      particlesJS.load('particles-js', base + 'vendor/particles-config.json', function () {});

      window.addEventListener('resize', function () {
        el.style.width = window.innerWidth + 'px';
        el.style.height = window.innerHeight + 'px';
      });
    }

    if (document.readyState === 'complete') {
      init();
    } else {
      window.addEventListener('load', init);
    }
  })();
</script>
