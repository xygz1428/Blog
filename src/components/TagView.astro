---
import { getAllPosts, formatDate, postSlug } from '../utils/posts';
import { withBase } from '../utils/url';
import { t, localizedHref, categoryLabel } from '../i18n/utils';
import { DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  tag: string;
}

const { locale, tag } = Astro.props;
const dict = t(locale);
const isDefault = locale === DEFAULT_LOCALE;
const all = await getAllPosts(locale);
const posts = all.filter((post) => post.data.tags.includes(tag));
---

<div class="page-head">
  <h1>{dict.tagsTitle}：{tag}</h1>
  <p>{dict.postCount(posts.length)} · <a href={withBase(localizedHref(locale, '/tags/'))}>{dict.tagsTitle}</a></p>
</div>

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <div class="post-item-main">
          <h2><a href={withBase(localizedHref(locale, `/blog/${postSlug(post)}/`))}>{post.data.title}</a></h2>
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span>·</span>
            {isDefault ? (
              <a href={withBase(`/categories/${post.data.category}/`)}>{post.data.category}</a>
            ) : (
              <span>{categoryLabel(locale, post.data.category)}</span>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ul>
