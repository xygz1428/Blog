---
import { Image } from 'astro:assets';
import { SITE } from '../site.mjs';
import { getAllPosts, getCategoryCounts, formatDate, postSlug } from '../utils/posts';
import { getCover } from '../utils/covers';
import heroImg from '../assets/hero.jpg';
import ParticleBackdrop from './ParticleBackdrop.astro';
import { withBase } from '../utils/url';
import { t, localizedHref, categoryLabel } from '../i18n/utils';
import { DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const isDefault = locale === DEFAULT_LOCALE;

const posts = await getAllPosts(locale);
const latest = posts.slice(0, SITE.pageSize);
// 首篇做大卡片，其余紧凑列表（视觉主次）
const [featured, ...rest] = latest;
const counts = await getCategoryCounts(locale);
const heroCover = heroImg;

// 首页大标题与副标题（按语言）
const heroCopy = {
  'zh-cn': {
    title: '记录科研、技术与生活',
    sub: 'Notes on research, engineering and everyday life.',
    lead: '这里记录科研过程、编程实践、学习笔记，以及一些生活随笔。慢一点写，写长一点。',
    tag: 'CC0 配图',
  },
  en: {
    title: 'Notes on research, engineering and life',
    sub: '记录科研、技术与生活。',
    lead: 'A place for research notes, engineering practice, study logs and the occasional essay. Written slowly, and at length.',
    tag: 'CC0 images',
  },
} as const;

const hc = heroCopy[locale];

// 非默认语言下只显示有文章的分类，避免一堆「0 posts」
const visibleCategories = isDefault
  ? SITE.categories
  : SITE.categories.filter((category) => (counts[category] ?? 0) > 0);
---

<section class="hero">
  <ParticleBackdrop count={14} linkDistance={160} />
  <div class="hero-text">
    <div class="hero-eyebrow">
      <span>+ A small blog for long thinking</span>
      <span>Est. 2026</span>
    </div>
    <h1>{hc.title}<span class="hero-mark">。</span></h1>
    <p class="hero-sub">{hc.sub}</p>
    <p class="hero-lead">{hc.lead}</p>
  </div>
  {
    heroCover && (
      <div class="hero-card">
        <Image src={heroCover} alt="" width={720} height={540} format="webp" loading="eager" />
        <span class="hero-tag hero-tag-a">{dict.postCount(posts.length)}</span>
        <span class="hero-tag hero-tag-b">{hc.tag}</span>
      </div>
    )
  }
</section>

<h2>{dict.latestPosts}</h2>
{
  latest.length === 0 ? (
    <p class="empty">{dict.noPosts}</p>
  ) : (
    <>
      {featured && (() => {
        const cover = getCover(featured.data.cover);
        const href = withBase(localizedHref(locale, `/blog/${postSlug(featured)}/`));
        return (
          <a class="post-featured" href={href}>
            {cover && (
              <div class="post-featured-media">
                <Image src={cover} alt="" width={720} height={420} format="webp" loading="eager" />
              </div>
            )}
            <div class="post-featured-body">
              <h3>{featured.data.title}</h3>
              <div class="post-meta">
                <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
                <span>·</span>
                <span>{categoryLabel(locale, featured.data.category)}</span>
              </div>
              {featured.data.description && <p class="post-desc">{featured.data.description}</p>}
            </div>
          </a>
        );
      })()}
    <ul class="post-list">
      {rest.map((post) => {
        const cover = getCover(post.data.cover);
        const href = withBase(localizedHref(locale, `/blog/${postSlug(post)}/`));
        return (
          <li class="post-item">
            <div class="post-item-main">
              <h2>
                <a href={href}>{post.data.title}</a>
              </h2>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span>·</span>
                {isDefault ? (
                  <a href={withBase(`/categories/${post.data.category}/`)}>{categoryLabel(locale, post.data.category)}</a>
                ) : (
                  <span>{categoryLabel(locale, post.data.category)}</span>
                )}
                {post.data.tags.length > 0 && <span>·</span>}
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              {post.data.description && <p class="post-desc">{post.data.description}</p>}
            </div>
            {cover && (
              <a class="post-thumb" href={href} tabindex="-1" aria-hidden="true">
                <Image src={cover} alt="" width={200} height={140} format="webp" loading="lazy" />
              </a>
            )}
          </li>
        );
      })}
    </ul>
    </>
  )
}

<p style="margin-top:1.5rem">
  <a href={withBase(localizedHref(locale, '/blog/'))}>{dict.allPosts} →</a>
</p>

<h2>{dict.categories}</h2>
<ul class="cat-grid">
  {
    visibleCategories.map((category) => (
      <li>
        {isDefault ? (
          <a class="cat-card" href={withBase(`/categories/${category}/`)}>
            <strong>{categoryLabel(locale, category)}</strong>
            <span>{dict.postCount(counts[category] ?? 0)}</span>
          </a>
        ) : (
          <div class="cat-card">
            <strong>{categoryLabel(locale, category)}</strong>
            <span>{dict.postCount(counts[category] ?? 0)}</span>
          </div>
        )}
      </li>
    ))
  }
</ul>
